# Where contact-form submissions are delivered (do not hardcode in source)
CONTACT_INBOX=you@example.com

# Brevo transactional email (contact form delivery)
# BREVO_API_KEY=
# Verified Brevo sender address (defaults to CONTACT_INBOX if unset)
# CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (Phase 2 — contact form spam protection)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
