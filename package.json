{
  "name": "contest-engine-marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "shots": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "demo:fetch": "node scripts/demo/fetch-stock.mjs",
    "demo:serve": "node scripts/demo/serve-media.mjs",
    "demo:seed": "node --env-file-if-exists=.env.local scripts/demo/seed.mjs",
    "demo:reset": "node --env-file-if-exists=.env.local scripts/demo/seed.mjs --reset-only",
    "capture:login": "node scripts/capture/login.mjs",
    "capture": "node scripts/capture/capture.mjs",
    "db:new": "dbmate $([ -f .env.local ] && echo '--env-file .env.local') -e NEON_DB_DIRECT_URL --no-dump-schema new",
    "db:migrate": "dbmate $([ -f .env.local ] && echo '--env-file .env.local') -e NEON_DB_DIRECT_URL --no-dump-schema migrate",
    "db:status": "dbmate $([ -f .env.local ] && echo '--env-file .env.local') -e NEON_DB_DIRECT_URL --no-dump-schema status",
    "db:rollback": "dbmate $([ -f .env.local ] && echo '--env-file .env.local') -e NEON_DB_DIRECT_URL --no-dump-schema rollback"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dbmate": "^2.34.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
