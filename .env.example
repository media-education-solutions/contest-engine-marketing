# Cloudflare Turnstile — spam protection on /contact and /buy (both forms share
# verifyTurnstile()). Set BOTH together: TURNSTILE_SECRET_KEY alone makes the
# server reject every human submission on both forms, since no widget token
# will ever be sent to match it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Neon Postgres — durable record of contact inquiries, purchase orders and judge
# applications (schema in db/migrations/). Pooled connection string from the Neon
# dashboard. NOT named DATABASE_URL.
NEON_DB_URL=
# Neon direct (UNPOOLED) connection — migrations only, used by dbmate. Same database
# as NEON_DB_URL, but the host WITHOUT `-pooler`. Schema migrations need session-level
# features that PgBouncer transaction pooling does not support. Belongs in .env.local.
NEON_DB_DIRECT_URL=

# Google Apps Script notification endpoint (see scripts/contact-sheet-endpoint.gs)
# Web app URL from Deploy > Manage deployments
CONTACT_SCRIPT_URL=
# Shared secret; must equal the TOKEN script property (openssl rand -hex 32)
CONTACT_SCRIPT_TOKEN=

# Stripe (MED-32) — server-side only; no publishable key is needed because
# checkout is Stripe-hosted, not embedded.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook. The value from `stripe listen` is for
# LOCAL only — production uses the secret from the dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
