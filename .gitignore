# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — bare .env is COMMITTED on purpose (non-secret config Vercel reads from
# the repo, MED-35). Every other variant holds secrets and stays out of git.
.env.*
!.env.example

# vercel
.vercel

# demo capture media (MED-42): re-download with `npm run demo:fetch`
/scripts/demo/.media/

# capture sessions are live logins; raw frames are large scratch (MED-42)
/scripts/capture/.auth/
/scripts/capture/.out/

# typescript
*.tsbuildinfo
next-env.d.ts

# AI
.claude
Claude.md
.agents
skills-lock.json

# Local docs
docs/
tests/__screenshots__/

# playwright artifacts
test-results/
playwright-report/

# lighthouse ci artifacts
.lighthouseci/

# Unprocessed source photos (processed assets live in public/assets/photo/founder/)
old teacher pics/
